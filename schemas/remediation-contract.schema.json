{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccabc.corp/guardian-avit/schemas/remediation-contract.schema.json",
  "title": "Bounded Remediation Task Contract",
  "description": "The complete, closed-world specification handed to an autonomous coding agent. Deny-by-default: anything not explicitly permitted is forbidden. This document IS the objective function.",
  "type": "object",
  "required": ["contract_id", "fix_unit", "batch", "attempt", "issued_at", "expires_at",
               "objective", "evidence", "change_surface", "forbidden_operations",
               "invariants", "expected_delta", "acceptance", "workspace", "budget", "escalation"],
  "additionalProperties": false,
  "properties": {
    "contract_id": {"type": "string", "pattern": "^RC-[A-Z0-9]+-[0-9]+-a[0-9]+$"},
    "fix_unit":    {"type": "string"},
    "batch":       {"type": "string"},
    "attempt":     {"type": "integer", "minimum": 1, "maximum": 2,
                    "description": "Hard cap of 2. Beyond this the work routes to a human; unbounded iteration against a gate is adversarial search."},
    "issued_at":   {"type": "string", "format": "date-time"},
    "expires_at":  {"type": "string", "format": "date-time"},
    "agent":       {"type": "string", "examples": ["devin", "copilot-coding-agent"]},
    "leases":      {"type": "array", "items": {"type": "string"},
                    "description": "File/symbol write leases held for this contract. No other contract may edit these."},

    "objective": {
      "type": "object",
      "required": ["must_become_true", "must_remain_true"],
      "description": "Never phrased as 'fix the vulnerability'. Every clause is a verifiable predicate with a named proof.",
      "properties": {
        "must_become_true": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "predicate", "proof"],
            "properties": {
              "id":        {"type": "string"},
              "predicate": {"type": "string"},
              "proof":     {"type": "string", "description": "The named test/gate that establishes it"}
            }
          }
        },
        "must_remain_true": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["invariant_id", "statement", "proof_test"],
            "properties": {
              "invariant_id": {"type": "string"},
              "statement":    {"type": "string"},
              "proof_test":   {"type": "string"},
              "enforcement":  {"enum": ["FORBID_MODIFY", "REQUIRE_PROOF", "ALLOW_WITH_TEST"]}
            }
          }
        }
      }
    },

    "evidence": {
      "type": "object",
      "required": ["findings"],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cvr_id", "scanner", "summary"],
            "properties": {
              "cvr_id": {"type": "string"}, "scanner": {"type": "string"},
              "native_id": {"type": "string"}, "summary": {"type": "string"},
              "flow_path": {"type": "array", "items": {"type": "string"}},
              "reproduction": {"type": "object", "description": "PoC request/steps; also the basis of the G6 proof-of-fix test"}
            }
          }
        },
        "reachability_summary": {"type": "string"},
        "runtime_profile": {"type": "object",
          "description": "Traffic evidence. Frequently the difference between constraining a feature and deleting it."}
      }
    },

    "business_context": {
      "type": "array", "items": {"type": "string"},
      "description": "Ratified, human-reviewed statements of intent. Sourced from the oracle, never delivered unratified."
    },

    "change_surface": {
      "type": "object",
      "required": ["allow", "deny"],
      "description": "Enforced three times: sandbox sparse checkout, sandbox pre-commit hook, and gate G0.",
      "properties": {
        "allow":     {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "deny":      {"type": "array", "items": {"type": "string"}},
        "read_only_context": {"type": "array", "items": {"type": "string"},
                     "description": "Readable for understanding; physically unwritable in the sandbox"},
        "new_files_permitted": {"type": "boolean", "default": false},
        "symbol_allow": {"type": "array", "items": {"type": "string"},
                     "description": "Optional symbol-level narrowing within an allowed file"}
      }
    },

    "forbidden_operations": {
      "type": "object",
      "description": "Each key maps 1:1 to a detector family in policy/anti-cheat-rules.yaml so prohibition and enforcement cannot drift apart.",
      "properties": {
        "security_controls":      {"type": "array", "items": {"type": "string"}},
        "validation":             {"type": "array", "items": {"type": "string"}},
        "error_handling":         {"type": "array", "items": {"type": "string"}},
        "contracts":              {"type": "array", "items": {"type": "string"}},
        "verification_integrity": {"type": "array", "items": {"type": "string"}},
        "scanner_silencing":      {"type": "array", "items": {"type": "string"}},
        "non_functional":         {"type": "array", "items": {"type": "string"}},
        "capability_removal":     {"type": "array", "items": {"type": "string"}},
        "dependencies":           {"type": "array", "items": {"type": "string"}}
      }
    },

    "required_patterns": {
      "type": "array",
      "description": "House-approved exemplars. Pointing at working in-repo code outperforms describing a pattern in prose.",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {"type": "string"},
          "exemplar_symbol": {"type": "string"},
          "exemplar_commit": {"type": "string"}
        }
      }
    },

    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["invariant_id", "class", "statement"],
        "properties": {
          "invariant_id": {"type": "string"},
          "zone_id":      {"type": "string"},
          "class":        {"enum": ["AUTHN","AUTHZ","TXN","IDEMPOTENCY","CONCURRENCY","RATE_LIMIT","CONTRACT","CRYPTO","PII_PCI","CACHE"]},
          "statement":    {"type": "string"},
          "enforcement":  {"enum": ["FORBID_MODIFY","REQUIRE_PROOF","ALLOW_WITH_TEST"]},
          "proof_tests":  {"type": "array", "items": {"type": "string"}},
          "ratified_by":  {"type": "string"},
          "version":      {"type": "integer"}
        }
      }
    },

    "characterization_lock": {
      "type": "object",
      "required": ["suite_path", "suite_sha256", "case_count", "mount"],
      "properties": {
        "suite_path":     {"type": "string"},
        "suite_sha256":   {"type": "string"},
        "fixtures_sha256":{"type": "string"},
        "case_count":     {"type": "integer"},
        "recorded_against_commit": {"type": "string"},
        "mutation_score": {"type": "number"},
        "mount":          {"const": "READ_ONLY"},
        "dimensions":     {"type": "array",
                           "items": {"enum": ["HTTP","NEGATIVE_AUTH_MATRIX","EVENTS","DB_EFFECTS","TXN_SPANS",
                                              "LOCKS","RATE_LIMITS","LATENCY","AUDIT_LOGS"]}}
      }
    },

    "expected_delta": {
      "type": "object",
      "required": ["cases", "policy"],
      "description": "The ONLY permitted behaviour changes. Declared before the agent runs, so 'did it break something' becomes an equality check.",
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "before", "after", "justification"],
            "properties": {
              "case_id":       {"type": "string"},
              "before":        {"type": "object"},
              "after":         {"type": "object"},
              "justification": {"type": "string"}
            }
          }
        },
        "policy": {
          "type": "object",
          "properties": {
            "unlisted_case_change": {"const": "REJECT", "description": "Collateral damage"},
            "unmet_expected_delta": {"const": "REJECT", "description": "The fix did not actually take effect — the highest-value anti-cheat check in the system"}
          }
        }
      }
    },

    "acceptance": {
      "type": "object",
      "required": ["gates"],
      "properties": {
        "gates": {"type": "array", "items": {"enum": ["G0","G1","G2","G3","G4","G5","G6","G7","G8"]}},
        "verification_plan_uri": {"type": "string", "format": "uri"},
        "scanner_reverification": {"type": "array", "items": {"type": "string"}}
      }
    },

    "workspace": {
      "type": "object",
      "required": ["sparse_checkout", "branch_namespace", "egress_allowlist", "credential_scope"],
      "properties": {
        "sparse_checkout":  {"type": "array", "items": {"type": "string"}},
        "branch_namespace": {"type": "string", "examples": ["guardian/RC-CCABC-2211-a1/*"]},
        "egress_allowlist": {"type": "array", "items": {"type": "string"}},
        "credential_scope": {
          "type": "object",
          "properties": {
            "repos":       {"type": "array", "items": {"type": "string"}},
            "permissions": {"type": "array", "items": {"type": "string"},
                            "description": "Never includes workflows:write — an agent must not be able to edit CI"},
            "ttl_minutes": {"type": "integer"}
          }
        },
        "readonly_mounts": {"type": "array", "items": {"type": "string"}}
      }
    },

    "budget": {
      "type": "object",
      "required": ["wall_clock_min", "iterations"],
      "properties": {
        "wall_clock_min": {"type": "integer"},
        "iterations":     {"type": "integer"},
        "max_tool_calls": {"type": "integer"},
        "max_tokens":     {"type": "integer"},
        "allowed_dependency_changes": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },

    "escalation": {
      "type": "object",
      "required": ["instruction", "reasons", "scoring"],
      "properties": {
        "instruction": {"type": "string"},
        "reasons": {"type": "array",
                    "items": {"enum": ["SURFACE_TOO_NARROW","INVARIANT_CONFLICT","FORBIDDEN_OP_REQUIRED",
                                       "MISSING_CONTEXT","BUDGET_EXHAUSTED","AMBIGUOUS_INTENT"]}},
        "report_fields": {"type": "array", "items": {"type": "string"}},
        "scoring": {"type": "string",
                    "description": "An accurate BLOCKED report scores as SUCCESS; a gate rejection scores as FAILURE. The incentive gradient must point away from improvisation."}
      }
    },

    "provenance_requirements": {
      "type": "object",
      "properties": {
        "hunk_rationale_required": {"type": "boolean", "default": true,
          "description": "Every diff hunk must cite the contract clause it serves; unattributed hunks fail G0"},
        "signed_commits": {"type": "boolean", "default": true}
      }
    },

    "risk": {
      "type": "object",
      "properties": {
        "blast_radius": {"type": "integer", "minimum": 0, "maximum": 100},
        "band":         {"enum": ["LOW","MEDIUM","HIGH","CRITICAL"]},
        "effort_tier":  {"enum": ["T1","T2","T3","T4","T5"]},
        "expected_review_tier": {"enum": ["MERGE_AUTONOMOUS","PEER_REVIEW","SECURITY_ARCHITECT","HUMAN_FIX"]}
      }
    }
  }
}
